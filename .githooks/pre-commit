#!/bin/sh
# Platform inventory gate. Versioned (core.hooksPath=.githooks) so it survives a re-clone.
#
# It BLOCKS a commit that leaves a .js file unclassified — the one moment where the cost of
# classifying is minutes and the cost of not classifying is a two-month archaeology dig.
#
# It skips silently where the platform checkout does not exist (CI, another machine, a fresh
# clone of one repo). A hook that fails on a machine it was never meant to run on gets deleted,
# and then it protects nothing.
[ -f /c/dev/inventory.cjs ] || exit 0
# ⚠️⚠️ GIT_DIR MUST NOT REACH inventory.cjs. It runs `git ls-files` once per repo with cwd set to that repo, and
# git exports GIT_DIR/GIT_INDEX_FILE/GIT_WORK_TREE into every hook. From a normal checkout GIT_DIR is the
# RELATIVE ".git", so it happens to resolve correctly in each repo and nobody notices. From a WORKTREE it is
# absolute — so chitbridge-api was listed with chitbridge-web's file names, every one of them classified under
# the wrong repo, and the hook blocked the commit naming files that do not exist. Every commit made from a
# `git worktree` was refused, with a message pointing at the wrong problem.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX
node /c/dev/inventory.cjs > /tmp/cb-inv.$$ 2>&1
if [ $? -ne 0 ]; then
  echo ""
  tail -12 /tmp/cb-inv.$$
  echo "  commit blocked — classify the file in C:/dev/inventory.cjs, or --no-verify if you must."
  rm -f /tmp/cb-inv.$$
  exit 1
fi
# Anchored: the summary line starts with two spaces. An unanchored match also catches prose
# in the generated table that merely contains the word "drift".
grep -aE '^  drift|REGROUPED' /tmp/cb-inv.$$
rm -f /tmp/cb-inv.$$
exit 0
