{
  "name": "chitbridge-web",
  "version": "1.0.0",
  "description": "Chit and Bridge — React Web Application",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check:syntax": "node scripts/check-syntax.js",
    "check:engines": "node ../chitbridge-engines/tools/adopt.cjs . --check",
    "check:pins": "node e2e/engines-pins-agree.cjs",
    "check:adoption": "node scripts/check-adoption.js",
    "check:cart": "node scripts/cart-ui.test.mjs && node scripts/cap-network-render.test.mjs",
    "check:steps": "node scripts/step-flow.test.mjs",
    "check:signin": "node tests/signin-ui.test.cjs",
    "check:homebar": "node tests/home-phone-bar.test.cjs",
    "check": "node e2e/guard-xss-handlers.cjs && npm run check:engines && npm run check:pins && npm run check:cart && npm run check:steps && npm run check:signin && npm run check:homebar && node scripts/check-syntax.js && node scripts/check-adoption.js && npm run check:reads && npm run check:lazy && npm run check:modal && npm run check:tax && npm run check:markup && npm run check:controls && npm run check:order && npm run check:calls && npm run check:till && npm run check:a11y && npm run check:envelope && npm run check:eps && npm run check:undeclared && npm run check:barereturn && npm run check:cmdb && npm run check:tokens && npm run check:money && npm run check:thread && npm run check:skeleton && npm run check:process && npm run check:graph",
    "parsecheck": "node scripts/check-app-parses.cjs",
    "check:reads": "node e2e/screen-reads.cjs",
    "check:lazy": "node e2e/lazy-screen-guard.cjs",
    "check:modal": "node e2e/modal-safe-repaint.cjs",
    "report:card": "node e2e/report-card.cjs",
    "check:tax": "node e2e/tax-slab.test.cjs && node e2e/tax-slab-ui.test.cjs",
    "check:calls": "node e2e/missing-functions.cjs && node e2e/knowledge-graph.cjs",
    "check:markup": "node e2e/markup-balance.cjs",
    "check:controls": "node e2e/list-controls.cjs",
    "check:order": "node e2e/list-behaviour.cjs",
    "check:till": "node e2e/till-contrast.cjs",
    "check:a11y": "node e2e/a11y-contrast.cjs",
    "check:envelope": "node e2e/api-envelope.cjs",
    "check:eps": "node e2e/ep-aliases.cjs",
    "check:undeclared": "node e2e/undeclared.cjs",
    "check:barereturn": "node e2e/bare-return-lint.cjs --selftest && node e2e/bare-return-lint.cjs",
    "check:cmdb": "node e2e/cmdb-records.cjs",
    "check:tokens": "node e2e/token-guard.cjs",
    "check:money": "node e2e/money-input-guard.cjs",
    "check:thread": "node e2e/rail-thread-guard.cjs",
    "check:skeleton": "node e2e/skeleton-guard.cjs",
    "check:process": "node e2e/process-map.cjs",
    "docs:process": "node tools/gen-process-docs.cjs",
    "check:themes": "node e2e/crm-themes.cjs",
    "check:graph": "node e2e/knowledge-graph.cjs",
    "audit:mobile": "node e2e/mobile-audit.cjs",
    "measure:waves": "node e2e/http-waves.cjs",
    "demo:floor": "node e2e/floor-demo.cjs",
    "look:health": "node e2e/_healthlook.cjs",
    "graph": "node tools/graph/graph.cjs build",
    "sweep:actions": "node scripts/action-state-sweep.cjs",
    "report:stars": "node tools/sig-stars.cjs web=. api=../chitbridge-api engines=../chitbridge-engines"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "axios": "^1.6.2",
    "react-swipeable": "^7.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "vite": "^8.3.5",
    "tailwindcss": "^3.3.6",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32"
  }
}
