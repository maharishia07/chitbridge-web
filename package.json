{
  "name": "chitbridge-web",
  "version": "1.0.0",
  "description": "Chit and Bridge — React Web Application",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check:syntax": "node scripts/check-syntax.js",
    "check:adoption": "node scripts/check-adoption.js",
    "check:cart": "node scripts/cart-ui.test.mjs && node scripts/cap-network-render.test.mjs",
    "check:steps": "node scripts/step-flow.test.mjs",
    "check": "npm run check:cart && npm run check:steps && node scripts/check-syntax.js && node scripts/check-adoption.js && npm run check:reads && npm run check:lazy",
    "parsecheck": "node scripts/check-app-parses.cjs",
    "check:reads": "node e2e/screen-reads.cjs",
    "check:lazy": "node e2e/lazy-screen-guard.cjs"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "axios": "^1.6.2",
    "react-swipeable": "^7.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "vite": "^5.0.0",
    "tailwindcss": "^3.3.6",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32"
  }
}
